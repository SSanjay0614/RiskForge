# Python cache and generated files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local configuration
.venv/
venv/
env/
ENV/
.env
.env.*

# Test, coverage, and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs and runtime output
logs/
**/logs/
*.log

# Local database
Database/credit_risk.db

# Local datasets and generated model artifacts
Data/
Models/

# SageMaker bundles built from Models/ -- regenerate with
# Deploy/sagemaker/build_artifacts.py rather than committing a booster
Deploy/sagemaker/dist/

# Jupyter notebook checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/
Notebooks/catboost_info/

# Terraform -- state can contain the Aurora master password in plaintext,
# and tfvars holds environment-specific values. Never commit either.
# .terraform.lock.hcl is deliberately NOT listed: it pins provider versions and
# their hashes, so it belongs in the repo.
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
# tfplan* rather than tfplan/tfplan.*: a saved plan named tfplan-phase8 matched
# neither, and a plan file carries the full resource attributes it is about to
# write -- not something to push to a public repo by accident.
tfplan*
*.tfplan
plan.json
crash.log
crash.*.log

# Cloud credentials and keys
*.pem
*.ppk

# OS and editor files
.DS_Store
Thumbs.db
.vscode/

# Lambda deployment packages and the fetched RDS CA bundle -- rebuild with
# Deploy/lambda/build.py rather than committing zips
Deploy/lambda/dist/
Deploy/lambda/build/
Deploy/lambda/shared/rds-global-bundle.pem

# The Fargate image's build context, assembled by Deploy/fargate/stage.py. It is
# a copy of files that are already in this repository plus two joblib frequency
# maps from the ignored Models/ -- so committing it would both duplicate tracked
# source and push artifacts that are deliberately untracked.
Deploy/fargate/build/
